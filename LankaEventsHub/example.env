# Copy to .env (which git ignores) and adjust for your machine.
# docker compose reads this file automatically; export the same values in
# your shell before `mvn spring-boot:run` so the app picks them up.

MYSQL_DATABASE=eventsphere
MYSQL_USER=eventsphere
MYSQL_PASSWORD=change-me-locally
MYSQL_ROOT_PASSWORD=change-me-locally

DB_URL=jdbc:mysql://localhost:3306/eventsphere?useSSL=false&serverTimezone=UTC
DB_USERNAME=eventsphere
DB_PASSWORD=change-me-locally

# false -> the token is created but never displayed or logged (the default,
#          and what any deployment should use)
# true  -> the reset link is shown on screen; turn this on ONLY while
#          testing the flow on your own machine
APP_PASSWORD_RESET_DEV_MODE=false

# true -> log every SQL statement Hibernate runs
SHOW_SQL=false

# --- Email notifications ---
# Leave MAIL_HOST empty and email is OFF: notifications are in-app only,
# exactly as they were before the email channel existed. Nothing is
# queued and nothing is lost. Fill these in and the same notifications
# are also emailed.
#
# MAIL_FROM defaults to MAIL_USERNAME, which is what most relays expect.
# Never commit a real MAIL_PASSWORD - this file is an example.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=EventSphere
MAIL_START_TLS=true
